{
  "name": "wexample/php-api-entity",
  "description": "Client-side entities, repositories and envelope for APIs served by wexample/symfony-api",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Wexample",
      "email": "contact@wexample.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.5",
    "wexample/php-api": ">=5.0.0",
    "wexample/php-helpers": ">=4.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\PhpApiEntity\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpApiEntity\\Tests\\": "tests/"
    }
  }
}
